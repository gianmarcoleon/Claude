. *----------------------------------------------------------------- estimation
. capture postclose hhet

. postfile hhet str16 outcome str24 group double(b se pv h n mean0) ///
>     using "$data/res_hetero.dta", replace

. 
. capture program drop hetrow

. program define hetrow
  1.     args var group cond
  2.     quietly {
  3.         count if `var'<. & `cond' & tie0==0
  4.         if r(N)<500 exit
  5.         sum `var' if `cond' & tie0==0 & running>=-5 & running<0
  6.         local m0 = r(mean)
  7.         capture rdrobust `var' running if `cond' & tie0==0, all
  8.         if _rc exit
  9.         local n = e(N_h_l) + e(N_h_r)
 10.     }
 11.     post hhet ("`var'") ("`group'") (e(tau_cl)) (e(se_tau_cl)) (e(pv_rb)) ///
>         (e(h_l)) (`n') (`m0')
 12. end

. 
. foreach v in accept retain2 samesch1 samesch2 inrural2 {
  2.     hetrow `v' "All"            "1==1"
  3.     hetrow `v' "Rural assigned" "rural_full==1"
  4.     hetrow `v' "Urban assigned" "rural_full==0"
  5.     hetrow `v' "Rural 1"        "rural_deg==1"
  6.     hetrow `v' "Rural 2"        "rural_deg==2"
  7.     hetrow `v' "Rural 3"        "rural_deg==3"
  8.     hetrow `v' "Bilingual"      "bilingue_d==1"
  9.     hetrow `v' "VRAEM"          "vraem_d==1"
 10.     hetrow `v' "Frontera"       "frontera_d==1"
 11.     hetrow `v' "Female"         "female==1"
 12.     hetrow `v' "Male"           "female==0"
 13.     hetrow `v' "Younger"        "older==0"
 14.     hetrow `v' "Older"          "older==1"
 15.     hetrow `v' "In payroll t0"  "inpayroll_base==1"
 16.     hetrow `v' "New entrant t0" "inpayroll_base==0"
 17.     hetrow `v' "Inicial"        "lev_inicial==1"
 18.     hetrow `v' "Primaria"       "lev_primaria==1"
 19.     hetrow `v' "Secundaria"     "lev_secundaria==1"
 20. }

