. *------------------------------------------------------------------------------*
. * 3. RD ESTIMATES: reduced form and fuzzy
. *------------------------------------------------------------------------------*
. capture postclose hres

. postfile hres str16 outcome str10 sample double(rf_b rf_se rf_pv fz_b fz_se fz_pv
>  h nl nr mean0) ///
>     using "$data/res_outcomes.dta", replace

. 
. capture program drop rdrow

. program define rdrow
  1.     args var sample cond
  2.     quietly {
  3.         count if `var'<. & `cond'
  4.         if r(N)<200 exit
  5.         * control mean just below cutoff
.         sum `var' if `cond' & running>=-5 & running<0
  6.         local m0 = r(mean)
  7.         rdrobust `var' running if `cond', all
  8.         local rb  = e(tau_cl)
  9.         local rse = e(se_tau_cl)
 10.         local rpv = e(pv_rb)
 11.         local h   = e(h_l)
 12.         local nl  = e(N_h_l)
 13.         local nr  = e(N_h_r)
 14.         capture rdrobust `var' running if `cond', fuzzy(bono) all
 15.         if !_rc {
 16.             local fb  = e(tau_cl)
 17.             local fse = e(se_tau_cl)
 18.             local fpv = e(pv_rb)
 19.         }
 20.         else {
 21.             local fb = .
 22.             local fse = .
 23.             local fpv = .
 24.         }
 25.     }
 26.     post hres ("`var'") ("`sample'") (`rb') (`rse') (`rpv') (`fb') (`fse') (`f
> pv') (`h') (`nl') (`nr') (`m0')
 27. end

. 
. foreach v in accept retain2 retain3 retain4 anywork1 anywork2 anywork3 ///
>              samesch1 samesch2 samesch3 director_ever {
  2.     rdrow `v' "Pooled" "concurso<. & tie0==0"
  3. }

. * promotion only meaningful for cohorts with 4+ years to 2021
. rdrow promoted_2021 "1517" "inlist(concurso,2015,2017) & tie0==0"

. * per-cohort acceptance and retention
. foreach y in 2015 2017 2018 2019 {
  2.     rdrow accept  "`y'" "concurso==`y' & tie0==0"
  3.     rdrow retain2 "`y'" "concurso==`y' & tie0==0"
  4. }

. * longer horizons for early cohorts
. rdrow nombrado5 "2015" "concurso==2015 & tie0==0"

. rdrow nombrado6 "2015" "concurso==2015 & tie0==0"

. rdrow retain4   "2015" "concurso==2015 & tie0==0"

. rdrow retain4   "2017" "concurso==2017 & tie0==0"

. postclose hres

