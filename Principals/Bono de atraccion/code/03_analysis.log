. *------------------------------------------------------------------------------*
. * 6. ROBUSTNESS: donut (drop exact-cutoff ties), bandwidth halved/doubled
. *------------------------------------------------------------------------------*
. use "$data/rd_analysis.dta", clear

. tempname rob

. postfile `rob' str16 outcome str16 spec double(b se pv) using "$data/res_robust.d
> ta", replace

. foreach v in accept retain2 samesch1 {
  2.     quietly rdrobust `v' running if running!=0, all
  3.     post `rob' ("`v'") ("baseline donut") (e(tau_cl)) (e(se_tau_cl)) (e(pv_rb)
> )
  4.     local hh = e(h_l)
  5.     quietly rdrobust `v' running, fuzzy(bono) all
  6.     post `rob' ("`v'") ("with ties fuzzy") (e(tau_cl)) (e(se_tau_cl)) (e(pv_rb
> ))
  7.     quietly rdrobust `v' running if running!=0, h(`=`hh'/2') all
  8.     post `rob' ("`v'") ("half bw") (e(tau_cl)) (e(se_tau_cl)) (e(pv_rb))
  9.     quietly rdrobust `v' running if running!=0, h(`=`hh'*2') all
 10.     post `rob' ("`v'") ("double bw") (e(tau_cl)) (e(se_tau_cl)) (e(pv_rb))
 11.     quietly rdrobust `v' running if running!=0, p(2) all
 12.     post `rob' ("`v'") ("quadratic") (e(tau_cl)) (e(se_tau_cl)) (e(pv_rb))
 13. }
