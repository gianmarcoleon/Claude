. * First-stage estimates: local linear with fixed bandwidths.
. * (rdrobust's data-driven bandwidth fails here because compliance is
. *  essentially deterministic: bono==0 for everyone below the cutoff.)
. gen byte above = running>=0

. gen run_above = running*above

. tempname fsres

. postfile `fsres' str12 sample double(h coef se nl nr) using "$data/res_firststage
> .dta", replace

. foreach hh in 5 10 {
  2.     foreach y in 2015 2017 2018 2019 {
  3.         quietly reg bono above running run_above if concurso==`y' & abs(runnin
> g)<=`hh' & tie0==0, robust
  4.         quietly count if concurso==`y' & running>=-`hh' & running<0 & tie0==0
  5.         local nl = r(N)
  6.         quietly count if concurso==`y' & running>=0 & running<=`hh' & tie0==0
  7.         local nr = r(N)
  8.         post `fsres' ("`y'") (`hh') (_b[above]) (_se[above]) (`nl') (`nr')
  9.     }
 10.     quietly reg bono above running run_above if abs(running)<=`hh' & tie0==0, 
> robust
 11.     quietly count if running>=-`hh' & running<0 & tie0==0
 12.     local nl = r(N)
 13.     quietly count if running>=0 & running<=`hh' & tie0==0
 14.     local nr = r(N)
 15.     post `fsres' ("Pooled") (`hh') (_b[above]) (_se[above]) (`nl') (`nr')
 16. }

. postclose `fsres'

