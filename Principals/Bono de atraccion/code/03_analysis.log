. *------------------------------------------------------------------------------*
. * 5. DYNAMICS: RD coefficient by years since concurso (pooled + 2015 cohort)
. *------------------------------------------------------------------------------*
. tempname dyn

. postfile `dyn' str10 sample k double(b se) using "$data/res_dynamics.dta", replac
> e

. forvalues k=1/6 {
  2.     capture confirm variable nombrado`k'
  3.     if _rc continue
  4.     quietly count if nombrado`k'<.
  5.     if r(N)>500 {
  6.         quietly rdrobust nombrado`k' running if running!=0, all
  7.         post `dyn' ("Pooled") (`k') (e(tau_cl)) (e(se_tau_cl))
  8.     }
  9.     quietly count if nombrado`k'<. & concurso==2015
 10.     if r(N)>500 {
 11.         quietly rdrobust nombrado`k' running if concurso==2015 & running!=0, a
> ll
 12.         post `dyn' ("2015") (`k') (e(tau_cl)) (e(se_tau_cl))
 13.     }
 14. }

. * same-school dynamics (pooled)
. forvalues k=1/6 {
  2.     capture confirm variable samesch`k'
  3.     if _rc continue
  4.     quietly count if samesch`k'<.
  5.     if r(N)>500 {
  6.         quietly rdrobust samesch`k' running if running!=0, all
  7.         post `dyn' ("SameschP") (`k') (e(tau_cl)) (e(se_tau_cl))
  8.     }
  9. }

. postclose `dyn'

